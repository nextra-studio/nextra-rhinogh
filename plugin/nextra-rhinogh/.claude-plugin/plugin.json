{
  "name": "nextra-rhinogh",
  "displayName": "Nextra for Rhino + Grasshopper",
  "version": "0.1.2",
  "description": "Six token-lean tools (view, query, run, gh_edit, undo, memory) for Rhino 8 and Grasshopper.",
  "author": {
    "name": "Tatsuki",
    "url": "https://github.com/Tatsuki0123/nextra-rhinogh"
  },
  "homepage": "https://github.com/Tatsuki0123/nextra-rhinogh",
  "repository": "https://github.com/Tatsuki0123/nextra-rhinogh",
  "license": "Apache-2.0",
  "keywords": [
    "rhino",
    "grasshopper",
    "mcp",
    "karamba"
  ],
  "mcpServers": {
    "nextra-rhinogh": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.js"
      ],
      "env": {
        "NEXTRA_MODE": "full"
      }
    }
  }
}
