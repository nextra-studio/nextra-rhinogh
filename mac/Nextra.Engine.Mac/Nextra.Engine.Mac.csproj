<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mac build of the engine: every source file of src/Nextra.Engine, unchanged. Hot reload works the same way. -->
  <Import Project="..\GrasshopperApiRefs.props" />
  <PropertyGroup>
    <AssemblyName>Nextra.Engine</AssemblyName>
    <RootNamespace>Nextra.Engine</RootNamespace>
    <Version>0.1.9</Version>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Nextra.Engine\**\*.cs" Exclude="..\..\src\Nextra.Engine\obj\**;..\..\src\Nextra.Engine\bin\**" LinkBase="shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- RhinoCommon/Grasshopper: the version installed with the Windows build, net7.0 lib = the cross-platform RhinoCommon -->
    <PackageReference Include="RhinoCommon" Version="8.36.26296.17001" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.36.26296.17001" ExcludeAssets="runtime" />
    <Reference Include="Rhino.Runtime.Code"><HintPath>$(RhinoCodeDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
